# Illumine 2026 Environment Configuration
# Copy this file to .env.local and populate the values.

# Canonical public site URL (fallback: https://illumine-ju-it.in)
NEXT_PUBLIC_SITE_URL=https://illumine-ju-it.in

# Supabase Public & Service Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# REQUIRED for administrative backend operations and DB maintenance scripts.
# NEVER expose SUPABASE_SERVICE_ROLE_KEY to the browser/client-side!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-32-char-secret

